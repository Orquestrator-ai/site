{"name":"Orquestrator","short_name":"Orquestrator","description":"Orquestrator builds software for physicians: Med Painel, a side panel that pastes phrases, prescriptions and documents wherever the cursor is; residency platforms that cite their sources; and one brain orchestrating a fleet of AIs. The clinical decision always stays with the physician.","start_url":"/","display":"standalone","background_color":"#000000","theme_color":"#000000","icons":[{"src":"/icon.svg","sizes":"any","type":"image/svg+xml","purpose":"any"},{"src":"/assets/icones/icone-192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"/assets/icones/icone-512.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"/assets/icones/icone-mascara-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}]}